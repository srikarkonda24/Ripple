{
  "manifest_version": 3,
  "name": "Ripple Team Sync",
  "version": "1.0.0",
  "description": "Synchronize user-selected ChatGPT tabs locally — collect latest responses and broadcast a combined prompt.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ripple Team Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["selectors.js", "agentDetector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
